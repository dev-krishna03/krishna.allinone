datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  READ_ONLY
}

enum OrgStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ProductStatus {
  ACTIVE
  BETA
  DEPRECATED
}

enum ProductCategory {
  CORE
  FINANCE
  OPERATIONS
  GROWTH
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ApiClientStatus {
  ACTIVE
  REVOKED
}

// 1. identity_users (Canonical user identity without Supabase Auth)
model IdentityUser {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  fullName        String         @map("full_name") @db.VarChar(255)
  status          String         @default("ACTIVE") @db.VarChar(50)
  isEmailVerified Boolean        @default(false) @map("is_email_verified")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials           IdentityCredentials?
  sessions              IdentitySession[]
  memberships           OrganizationMember[]
  sentInvitations       OrganizationInvitation[] @relation("InvitedByRelation")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  securityEvents        IdentitySecurityEvent[]
  auditLogs             AuditLog[]

  @@index([email])
  @@map("identity_users")
}

// 2. identity_credentials (Strong password hash)
model IdentityCredentials {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  passwordHash String       @map("password_hash") @db.VarChar(255)
  algorithm    String       @default("bcrypt") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_credentials")
}

// 3. identity_sessions (Active user sessions & device metadata)
model IdentitySession {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  userAgent        String?                @map("user_agent") @db.Text
  ipAddress        String?                @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user             IdentityUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    IdentityRefreshToken[]

  @@index([userId, revokedAt])
  @@map("identity_sessions")
}

// 4. identity_refresh_tokens (Rotating refresh tokens with family reuse detection)
model IdentityRefreshToken {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  tokenHash String          @map("token_hash") @db.VarChar(255)
  familyId  String          @map("family_id") @db.Uuid
  isUsed    Boolean         @default(false) @map("is_used")
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  session   IdentitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@map("identity_refresh_tokens")
}

// 5. organizations (Canonical tenant entity)
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  legalName String?   @map("legal_name") @db.VarChar(255)
  timezone  String    @default("UTC") @db.VarChar(50)
  locale    String    @default("en-US") @db.VarChar(20)
  country   String    @default("US") @db.VarChar(2)
  currency  String    @default("USD") @db.VarChar(3)
  seatLimit Int       @default(25) @map("seat_limit")
  status    OrgStatus @default(ACTIVE)
  planTier  PlanTier  @default(STARTER)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members         OrganizationMember[]
  invitations     OrganizationInvitation[]
  auditLogs       AuditLog[]
  apiClients      ApiClient[]
  supportRequests SupportRequest[]

  @@index([slug])
  @@map("organizations")
}

// 6. organization_members (Tenant membership & role)
model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           UserRole     @default(EMPLOYEE)
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_members")
}

// 7. organization_invitations (Cryptographic invitations with TTL)
model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @db.VarChar(255)
  role           UserRole     @default(EMPLOYEE)
  token          String       @unique @db.VarChar(255)
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  invitedById    String       @map("invited_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      IdentityUser @relation("InvitedByRelation", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([token])
  @@map("organization_invitations")
}

// 8. email_verification_tokens (Single-use email verification tokens)
model EmailVerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique @db.VarChar(255)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

// 9. password_reset_tokens (Single-use password reset tokens)
model PasswordResetToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique @db.VarChar(255)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// 10. identity_security_events (Security event audit stream)
model IdentitySecurityEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  eventType      String        @map("event_type") @db.VarChar(100)
  metadata       Json?         @db.JsonB
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user           IdentityUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType])
  @@map("identity_security_events")
}

// 11. marketing_enquiries (Lead / demo requests - disjoint from CRM account)
model MarketingEnquiry {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(255)
  email           String        @db.VarChar(255)
  companyName     String        @map("company_name") @db.VarChar(255)
  productInterest String?       @map("product_interest") @db.VarChar(100)
  message         String        @db.Text
  status          EnquiryStatus @default(NEW)
  source          String?       @default("website") @db.VarChar(100)
  ipAddress       String?       @map("ip_address") @db.VarChar(45)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([status])
  @@map("marketing_enquiries")
}

// 12. platform_event_outbox (Transactional Outbox)
model PlatformEventOutbox {
  id            String       @id @default(uuid()) @db.Uuid
  eventName     String       @map("event_name") @db.VarChar(150)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("platform_event_outbox")
}

// 13. audit_log (Immutable security and operational event log)
model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String        @db.VarChar(100)
  entityType     String        @map("entity_type") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.VarChar(100)
  metadata       Json?         @db.JsonB
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          IdentityUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_log")
}

// 14. product_catalog_placeholder (Dynamic product & pricing catalog)
model ProductCatalogPlaceholder {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(100)
  name            String          @db.VarChar(255)
  description     String          @db.Text
  category        ProductCategory @default(CORE)
  priceAmount     Decimal         @map("price_amount") @db.Decimal(12, 2)
  currency        String          @default("USD") @db.VarChar(3)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  status          ProductStatus   @default(ACTIVE)
  features        String[]        @default([])
  metadata        Json?           @db.JsonB
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([category])
  @@map("product_catalog_placeholder")
}

// 15. api_clients (Developer Console API tokens)
model ApiClient {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(255)
  clientId       String          @unique @map("client_id") @db.VarChar(100)
  hashedSecret   String          @map("hashed_secret") @db.VarChar(255)
  scopes         String[]        @default(["read"])
  status         ApiClientStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?       @map("revoked_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_clients")
}

// 16. support_requests (Support tracking)
model SupportRequest {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  requesterEmail String          @map("requester_email") @db.VarChar(255)
  subject        String          @db.VarChar(255)
  priority       SupportPriority @default(MEDIUM)
  status         SupportStatus   @default(OPEN)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("support_requests")
}
