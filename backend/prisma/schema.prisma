datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  READ_ONLY
}

enum OrgStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ProductStatus {
  ACTIVE
  BETA
  DEPRECATED
}

enum ProductCategory {
  CORE
  FINANCE
  OPERATIONS
  GROWTH
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ApiClientStatus {
  ACTIVE
  REVOKED
}

enum PermissionSensitivity {
  NORMAL
  SENSITIVE
  CRITICAL
}

enum RecordScope {
  OWNER_ONLY
  TEAM
  DEPARTMENT
  ALL
}

enum GranteeType {
  USER
  TEAM
}

enum AccessLevel {
  READ
  WRITE
  ADMIN
}

enum FieldPolicyType {
  READ_WRITE
  READ_ONLY
  HIDE
  MASK
}

enum SaaSProductStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum FeatureType {
  BOOLEAN
  LIMIT
  METERED
}

enum PlanEdition {
  COMMUNITY
  STARTER
  GROWTH
  ENTERPRISE
}

enum PlanPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EntitlementStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SeatStatus {
  ACTIVE
  REVOKED
}

enum SaaSSubscriptionStatus {
  TRIALING
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLING
  CANCELLED
  EXPIRED
}

enum CheckoutSessionStatus {
  OPEN
  COMPLETED
  EXPIRED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum SaaSInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum SaaSPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SaaSRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DunningStatus {
  IN_PROGRESS
  RECOVERED
  FAILED
}

enum PlatformAdminRoleType {
  PLATFORM_ADMIN
  OPERATOR
  SUPPORT_TIER_2
  SECURITY_OFFICER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
}

enum ConnectorAuthType {
  OAUTH2
  API_KEY
  WEBHOOK
  CUSTOM
}

enum ConnectorInstallationStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  FAILED
}

enum WebhookSubscriptionStatus {
  ACTIVE
  SUSPENDED
  FAILING
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

enum MarketplaceReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum MarketplacePricingType {
  FREE
  INCLUDED
  PAID_ADDON
}

// 1. identity_users (Canonical user identity without Supabase Auth)
model IdentityUser {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  fullName        String         @map("full_name") @db.VarChar(255)
  status          String         @default("ACTIVE") @db.VarChar(50)
  isEmailVerified Boolean        @default(false) @map("is_email_verified")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials           IdentityCredentials?
  sessions              IdentitySession[]
  memberships           OrganizationMember[]
  sentInvitations       OrganizationInvitation[] @relation("InvitedByRelation")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  securityEvents        IdentitySecurityEvent[]
  auditLogs             AuditLog[]
  adminRoles            PlatformAdminRole[]
  createdPages          WsPage[]                 @relation("PageCreatedBy")
  pageRevisions         WsPageRevision[]         @relation("RevisionCreatedBy")
  pagePermissions       WsPagePermission[]       @relation("PagePermissionUser")
  pageComments          WsPageComment[]          @relation("CommentAuthor")
  collabEvents          WsPageCollabEvent[]      @relation("CollabEventUser")
  pageFavorites         WsPageFavorite[]         @relation("PageFavoriteUser")

  @@index([email])
  @@map("identity_users")
}

// 2. identity_credentials (Strong password hash)
model IdentityCredentials {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  passwordHash String       @map("password_hash") @db.VarChar(255)
  algorithm    String       @default("bcrypt") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_credentials")
}

// 3. identity_sessions (Active user sessions & device metadata)
model IdentitySession {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  userAgent        String?                @map("user_agent") @db.Text
  ipAddress        String?                @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user             IdentityUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    IdentityRefreshToken[]

  @@index([userId, revokedAt])
  @@map("identity_sessions")
}

// 4. identity_refresh_tokens (Rotating refresh tokens with family reuse detection)
model IdentityRefreshToken {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  tokenHash String          @map("token_hash") @db.VarChar(255)
  familyId  String          @map("family_id") @db.Uuid
  isUsed    Boolean         @default(false) @map("is_used")
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  session   IdentitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@map("identity_refresh_tokens")
}

// 5. organizations (Canonical tenant entity)
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  legalName String?   @map("legal_name") @db.VarChar(255)
  timezone  String    @default("UTC") @db.VarChar(50)
  locale    String    @default("en-US") @db.VarChar(20)
  country   String    @default("US") @db.VarChar(2)
  currency  String    @default("USD") @db.VarChar(3)
  seatLimit Int       @default(25) @map("seat_limit")
  status    OrgStatus @default(ACTIVE)
  planTier  PlanTier  @default(STARTER)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members             OrganizationMember[]
  invitations         OrganizationInvitation[]
  auditLogs           AuditLog[]
  apiClients          ApiClient[]
  supportRequests     SupportRequest[]
  roles               OrgRole[]
  memberRoles         OrgMemberRole[]
  teams               OrgTeam[]
  recordGrants        RecordAccessGrant[]
  fieldPolicies       OrgFieldPolicy[]
  policyVersion       AccessPolicyVersion?
  securityAuditEvents SecurityAuditEvent[]
  entitlements        OrgEntitlement[]
  seatAssignments     OrgSeatAssignment[]
  usageMeters         UsageMeter[]
  usageEvents         UsageEvent[]
  saasCustomer          SaaSCustomer?
  saasSubscriptions     SaaSSubscription[]
  saasInvoices          SaaSInvoice[]
  saasPayments          SaaSPayment[]
  saasCheckoutSessions  SaaSCheckoutSession[]
  saasCreditAdjustments SaaSCreditAdjustment[]
  connectorInstallations ConnectorInstallation[]
  oauthStates            OAuthState[]
  developerApiKeys       DeveloperApiKey[]
  webhookSubscriptions   WebhookSubscription[]
  workspaces             WsWorkspace[]
  workspacePages         WsPage[]
  workspaceBlocks        WsPageBlock[]
  workspaceRevisions     WsPageRevision[]
  workspacePermissions   WsPagePermission[]
  workspaceComments      WsPageComment[]
  workspaceCollabSnapshots WsPageCollabSnapshot[]
  workspaceCollabEvents  WsPageCollabEvent[]
  workspaceFavorites     WsPageFavorite[]

  @@index([slug])
  @@map("organizations")
}

// 6. organization_members (Tenant membership & role)
model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           UserRole     @default(EMPLOYEE)
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                IdentityUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments     OrgMemberRole[]
  teamMemberships     OrgTeamMember[]
  ledTeams            OrgTeam[]
  seatAssignments     OrgSeatAssignment[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_members")
}

// 7. organization_invitations (Cryptographic invitations with TTL)
model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @db.VarChar(255)
  role           UserRole     @default(EMPLOYEE)
  token          String       @unique @db.VarChar(255)
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  invitedById    String       @map("invited_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      IdentityUser @relation("InvitedByRelation", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([token])
  @@map("organization_invitations")
}

// 8. email_verification_tokens (Single-use email verification tokens)
model EmailVerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique @db.VarChar(255)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

// 9. password_reset_tokens (Single-use password reset tokens)
model PasswordResetToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique @db.VarChar(255)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// 10. identity_security_events (Security event audit stream)
model IdentitySecurityEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  eventType      String        @map("event_type") @db.VarChar(100)
  metadata       Json?         @db.JsonB
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user           IdentityUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType])
  @@map("identity_security_events")
}

// 11. marketing_enquiries (Lead / demo requests - disjoint from CRM account)
model MarketingEnquiry {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(255)
  email           String        @db.VarChar(255)
  companyName     String        @map("company_name") @db.VarChar(255)
  productInterest String?       @map("product_interest") @db.VarChar(100)
  message         String        @db.Text
  status          EnquiryStatus @default(NEW)
  source          String?       @default("website") @db.VarChar(100)
  ipAddress       String?       @map("ip_address") @db.VarChar(45)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([status])
  @@map("marketing_enquiries")
}

// 12. platform_event_outbox (Transactional Outbox)
model PlatformEventOutbox {
  id            String       @id @default(uuid()) @db.Uuid
  eventName     String       @map("event_name") @db.VarChar(150)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("platform_event_outbox")
}

// 13. audit_log (Immutable security and operational event log)
model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String        @db.VarChar(100)
  entityType     String        @map("entity_type") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.VarChar(100)
  metadata       Json?         @db.JsonB
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          IdentityUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_log")
}

// 14. product_catalog_placeholder (Dynamic product & pricing catalog)
model ProductCatalogPlaceholder {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(100)
  name            String          @db.VarChar(255)
  description     String          @db.Text
  category        ProductCategory @default(CORE)
  priceAmount     Decimal         @map("price_amount") @db.Decimal(12, 2)
  currency        String          @default("USD") @db.VarChar(3)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  status          ProductStatus   @default(ACTIVE)
  features        String[]        @default([])
  metadata        Json?           @db.JsonB
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([category])
  @@map("product_catalog_placeholder")
}

// 15. api_clients (Developer Console API tokens)
model ApiClient {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(255)
  clientId       String          @unique @map("client_id") @db.VarChar(100)
  hashedSecret   String          @map("hashed_secret") @db.VarChar(255)
  scopes         String[]        @default(["read"])
  status         ApiClientStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?       @map("revoked_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_clients")
}

// 16. support_requests (Support tracking)
model SupportRequest {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  requesterEmail String          @map("requester_email") @db.VarChar(255)
  subject        String          @db.VarChar(255)
  priority       SupportPriority @default(MEDIUM)
  status         SupportStatus   @default(OPEN)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("support_requests")
}

// 17. platform_permission_registry (System-wide granular permission definitions)
model PlatformPermissionRegistry {
  id          String                @id @default(uuid()) @db.Uuid
  module      String                @db.VarChar(100)
  resource    String                @db.VarChar(100)
  action      String                @db.VarChar(100)
  sensitivity PermissionSensitivity @default(NORMAL)
  label       String                @db.VarChar(255)
  description String?               @db.Text
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions OrgRolePermission[]

  @@unique([module, resource, action])
  @@index([module])
  @@map("platform_permission_registry")
}

// 18. org_roles (Custom organization RBAC roles with optional inheritance)
model OrgRole {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  code           String    @db.VarChar(100)
  isBuiltIn      Boolean   @default(false) @map("is_built_in")
  parentRoleId   String?   @map("parent_role_id") @db.Uuid
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentRole     OrgRole?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles     OrgRole[]           @relation("RoleHierarchy")
  permissions    OrgRolePermission[]
  memberRoles    OrgMemberRole[]
  fieldPolicies  OrgFieldPolicy[]
  pagePermissions WsPagePermission[]  @relation("PagePermissionRole")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("org_roles")
}

// 19. org_role_permissions (Role grants mapping to permissions and record scopes)
model OrgRolePermission {
  id           String      @id @default(uuid()) @db.Uuid
  roleId       String      @map("role_id") @db.Uuid
  permissionId String      @map("permission_id") @db.Uuid
  recordScope  RecordScope @default(ALL) @map("record_scope")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  role         OrgRole                    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PlatformPermissionRegistry @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("org_role_permissions")
}

// 20. org_member_roles (Multi-role assignments for organization members)
model OrgMemberRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role           OrgRole            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([organizationId, memberId])
  @@index([roleId])
  @@map("org_member_roles")
}

// 21. org_teams (Teams & department organizational hierarchy)
model OrgTeam {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  code           String    @db.VarChar(100)
  parentTeamId   String?   @map("parent_team_id") @db.Uuid
  leadMemberId   String?   @map("lead_member_id") @db.Uuid
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentTeam     OrgTeam?            @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams     OrgTeam[]           @relation("TeamHierarchy")
  leadMember     OrganizationMember? @relation(fields: [leadMemberId], references: [id], onDelete: SetNull)
  members        OrgTeamMember[]
  pagePermissions WsPagePermission[]  @relation("PagePermissionTeam")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("org_teams")
}

// 22. org_team_members (Team membership mapping)
model OrgTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team      OrgTeam            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member    OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([teamId])
  @@index([memberId])
  @@map("org_team_members")
}

// 23. record_access_grants (Direct record sharing to specific users or teams)
model RecordAccessGrant {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  resourceType   String      @map("resource_type") @db.VarChar(100)
  recordId       String      @map("record_id") @db.VarChar(100)
  granteeType    GranteeType @map("grantee_type")
  granteeId      String      @map("grantee_id") @db.Uuid
  accessLevel    AccessLevel @default(READ) @map("access_level")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, recordId])
  @@index([organizationId, granteeId])
  @@map("record_access_grants")
}

// 24. org_field_policies (Field-level security: read-write, read-only, hide, mask)
model OrgFieldPolicy {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  roleId         String?         @map("role_id") @db.Uuid
  resourceType   String          @map("resource_type") @db.VarChar(100)
  fieldName      String          @map("field_name") @db.VarChar(100)
  policy         FieldPolicyType @default(READ_WRITE)
  maskPattern    String?         @default("REDACTED") @map("mask_pattern") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole?        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleId, resourceType, fieldName])
  @@index([organizationId, resourceType])
  @@map("org_field_policies")
}

// 25. access_policy_versions (Version tracking for fast caching & invalidation)
model AccessPolicyVersion {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  version        Int          @default(1)
  updatedBy      String?      @map("updated_by") @db.Uuid
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("access_policy_versions")
}

// 26. security_audit_events (Dedicated security policy and permission audit trail)
model SecurityAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  action         String       @db.VarChar(150)
  targetType     String       @map("target_type") @db.VarChar(100)
  targetId       String?      @map("target_id") @db.VarChar(100)
  metadata       Json?        @db.JsonB
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("security_audit_events")
}

// ==========================================
// PHASE 1.4: Dynamic Catalog, Plans, Entitlements & Licensing
// ==========================================

// 27. saas_products (Platform products/modules catalog)
model SaaSProduct {
  id           String            @id @default(uuid()) @db.Uuid
  slug         String            @unique @db.VarChar(100)
  name         String            @db.VarChar(255)
  description  String            @db.Text
  icon         String?           @db.VarChar(100)
  status       SaaSProductStatus @default(ACTIVE)
  category     ProductCategory   @default(CORE)
  dependencies String[]          @default([])
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  features        SaaSProductFeature[]
  plans           SaaSPlan[]
  bundleItems     SaaSBundleItem[]
  entitlements    OrgEntitlement[]
  seatAssignments OrgSeatAssignment[]

  @@index([status])
  @@index([category])
  @@map("saas_products")
}

// 28. saas_product_features (Fine-grained features of products)
model SaaSProductFeature {
  id           String      @id @default(uuid()) @db.Uuid
  productId    String      @map("product_id") @db.Uuid
  code         String      @db.VarChar(100)
  name         String      @db.VarChar(255)
  description  String?     @db.Text
  type         FeatureType @default(BOOLEAN)
  defaultLimit Decimal?    @map("default_limit") @db.Decimal(14, 2)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  product SaaSProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@index([code])
  @@map("saas_product_features")
}

// 29. saas_plans (Plans and editions for products or bundles)
model SaaSPlan {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String?           @map("product_id") @db.Uuid
  name            String            @db.VarChar(255)
  code            String            @unique @db.VarChar(100)
  edition         PlanEdition       @default(STARTER)
  billingInterval BillingInterval   @default(MONTHLY) @map("billing_interval")
  isBundle        Boolean           @default(false) @map("is_bundle")
  status          PlanPublishStatus @default(DRAFT)
  trialDays       Int               @default(14) @map("trial_days")
  includedSeats   Int               @default(5) @map("included_seats")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      SaaSProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  versions     SaaSPlanVersion[]
  entitlements OrgEntitlement[]
  subscriptions    SaaSSubscription[]
  checkoutSessions SaaSCheckoutSession[]

  @@index([status])
  @@index([edition])
  @@map("saas_plans")
}

// 30. saas_plan_versions (Grandfathered rates & price version history)
model SaaSPlanVersion {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  version       Int       @default(1)
  priceAmount   Decimal   @map("price_amount") @db.Decimal(12, 2)
  currency      String    @default("USD") @db.VarChar(3)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  featureLimits Json?     @map("feature_limits") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  plan         SaaSPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlements OrgEntitlement[]
  subscriptions    SaaSSubscription[]
  checkoutSessions SaaSCheckoutSession[]

  @@unique([planId, version])
  @@index([planId, version])
  @@map("saas_plan_versions")
}

// 31. saas_bundles (Commercial bundles and Full Suite packages)
model SaaSBundle {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(100)
  name        String            @db.VarChar(255)
  description String            @db.Text
  status      SaaSProductStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  bundleItems  SaaSBundleItem[]
  entitlements OrgEntitlement[]

  @@map("saas_bundles")
}

// 32. saas_bundle_items (Included products in bundles)
model SaaSBundleItem {
  id        String   @id @default(uuid()) @db.Uuid
  bundleId  String   @map("bundle_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bundle  SaaSBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product SaaSProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@map("saas_bundle_items")
}

// 33. org_entitlements (Active tenant subscriptions & product licenses)
model OrgEntitlement {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  productId          String?           @map("product_id") @db.Uuid
  bundleId           String?           @map("bundle_id") @db.Uuid
  planId             String            @map("plan_id") @db.Uuid
  planVersionId      String            @map("plan_version_id") @db.Uuid
  status             EntitlementStatus @default(ACTIVE)
  effectiveFrom      DateTime          @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo        DateTime?         @map("effective_to") @db.Timestamptz(6)
  assignedSeatsLimit Int               @default(5) @map("assigned_seats_limit")
  featureOverrides   Json?             @map("feature_overrides") @db.JsonB
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      SaaSProduct?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle       SaaSBundle?         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  plan         SaaSPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  planVersion  SaaSPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  seats        OrgSeatAssignment[]

  @@index([organizationId, status])
  @@index([productId])
  @@index([bundleId])
  @@map("org_entitlements")
}

// 34. org_seat_assignments (Per-member product license allocations)
model OrgSeatAssignment {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  memberId       String     @map("member_id") @db.Uuid
  productId      String?    @map("product_id") @db.Uuid
  entitlementId  String     @map("entitlement_id") @db.Uuid
  status         SeatStatus @default(ACTIVE)
  assignedAt     DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product      SaaSProduct?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  entitlement  OrgEntitlement     @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([organizationId, memberId, entitlementId])
  @@index([organizationId, memberId])
  @@index([entitlementId])
  @@map("org_seat_assignments")
}

// 35. usage_meters (Durable quota and threshold tracking per tenant/period)
model UsageMeter {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  featureCode    String    @map("feature_code") @db.VarChar(100)
  periodStart    DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime  @map("period_end") @db.Timestamptz(6)
  currentUsage   Decimal   @default(0) @map("current_usage") @db.Decimal(14, 2)
  softLimit      Decimal?  @map("soft_limit") @db.Decimal(14, 2)
  hardLimit      Decimal?  @map("hard_limit") @db.Decimal(14, 2)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureCode, periodStart])
  @@index([organizationId, featureCode])
  @@map("usage_meters")
}

// 36. usage_events (Deduplicated usage intake events with operationId)
model UsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  operationId    String   @unique @map("operation_id") @db.VarChar(150)
  featureCode    String   @map("feature_code") @db.VarChar(100)
  quantity       Decimal  @db.Decimal(14, 2)
  timestamp      DateTime @default(now()) @db.Timestamptz(6)
  metadata       Json?    @db.JsonB

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, featureCode, timestamp])
  @@map("usage_events")
}

// 37. price_books (Multi-currency and regional pricing definitions)
model PriceBook {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  currency  String   @default("USD") @db.VarChar(3)
  region    String   @default("GLOBAL") @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("price_books")
}

// 38. saas_customers (Mapping between organization and external billing provider)
model SaaSCustomer {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  providerCustomerId String?  @map("provider_customer_id") @db.VarChar(150)
  provider           String   @default("STRIPE") @db.VarChar(50)
  billingEmail       String   @map("billing_email") @db.VarChar(255)
  billingName        String?  @map("billing_name") @db.VarChar(255)
  taxId              String?  @map("tax_id") @db.VarChar(100)
  address            Json?    @db.JsonB
  paymentMethodLast4 String?  @map("payment_method_last4") @db.VarChar(4)
  paymentMethodBrand String?  @map("payment_method_brand") @db.VarChar(50)
  paymentMethodExpiry String? @map("payment_method_expiry") @db.VarChar(10)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions    SaaSSubscription[]
  invoices         SaaSInvoice[]
  checkoutSessions SaaSCheckoutSession[]

  @@map("saas_customers")
}

// 39. saas_subscriptions (SaaS lifecycle subscription state machine)
model SaaSSubscription {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @map("organization_id") @db.Uuid
  customerId             String                 @map("customer_id") @db.Uuid
  planId                 String                 @map("plan_id") @db.Uuid
  planVersionId          String                 @map("plan_version_id") @db.Uuid
  providerSubscriptionId String?                @map("provider_subscription_id") @db.VarChar(150)
  status                 SaaSSubscriptionStatus @default(PENDING)
  seatQuantity           Int                    @default(5) @map("seat_quantity")
  currentPeriodStart     DateTime               @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime               @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean                @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?              @map("canceled_at") @db.Timestamptz(6)
  trialStart             DateTime?              @map("trial_start") @db.Timestamptz(6)
  trialEnd               DateTime?              @map("trial_end") @db.Timestamptz(6)
  metadata               Json?                  @db.JsonB
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          SaaSCustomer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan              SaaSPlan               @relation(fields: [planId], references: [id])
  planVersion       SaaSPlanVersion        @relation(fields: [planVersionId], references: [id])
  terms             SaaSSubscriptionTerm[]
  events            SaaSSubscriptionEvent[]
  invoices          SaaSInvoice[]
  dunningRuns       SaaSDunningRun[]
  creditAdjustments SaaSCreditAdjustment[]

  @@index([organizationId, status])
  @@index([providerSubscriptionId])
  @@map("saas_subscriptions")
}

// 40. saas_subscription_terms (Contract terms, seat quantities, and rate snapshots)
model SaaSSubscriptionTerm {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  termNumber     Int      @default(1) @map("term_number")
  startDate      DateTime @map("start_date") @db.Timestamptz(6)
  endDate        DateTime @map("end_date") @db.Timestamptz(6)
  seatQuantity   Int      @map("seat_quantity")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  currency       String   @default("USD") @db.VarChar(3)
  quoteSnapshot  Json     @map("quote_snapshot") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription SaaSSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, termNumber])
  @@map("saas_subscription_terms")
}

// 41. saas_subscription_events (State transition audit log)
model SaaSSubscriptionEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  subscriptionId String                  @map("subscription_id") @db.Uuid
  previousStatus SaaSSubscriptionStatus? @map("previous_status")
  newStatus      SaaSSubscriptionStatus  @map("new_status")
  reason         String                  @db.VarChar(255)
  actorId        String?                 @map("actor_id") @db.Uuid
  metadata       Json?                   @db.JsonB
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription SaaSSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("saas_subscription_events")
}

// 42. saas_checkout_sessions (Signed quotes and checkout token flows)
model SaaSCheckoutSession {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  customerId         String?               @map("customer_id") @db.Uuid
  planId             String                @map("plan_id") @db.Uuid
  planVersionId      String                @map("plan_version_id") @db.Uuid
  idempotencyKey     String                @unique @map("idempotency_key") @db.VarChar(150)
  sessionToken       String                @unique @map("session_token") @db.VarChar(255)
  providerSessionId  String?               @map("provider_session_id") @db.VarChar(200)
  amountTotal        Decimal               @map("amount_total") @db.Decimal(12, 2)
  currency           String                @default("USD") @db.VarChar(3)
  seatQuantity       Int                   @default(5) @map("seat_quantity")
  status             CheckoutSessionStatus @default(OPEN)
  successUrl         String                @map("success_url") @db.Text
  cancelUrl          String                @map("cancel_url") @db.Text
  quoteSnapshot      Json                  @map("quote_snapshot") @db.JsonB
  expiresAt          DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     SaaSCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  plan         SaaSPlan        @relation(fields: [planId], references: [id])
  planVersion  SaaSPlanVersion @relation(fields: [planVersionId], references: [id])

  @@index([organizationId, status])
  @@index([sessionToken])
  @@map("saas_checkout_sessions")
}

// 43. saas_provider_events (Raw payment provider webhook intake store)
model SaaSProviderEvent {
  id                String              @id @default(uuid()) @db.Uuid
  provider          String              @db.VarChar(50)
  eventId           String              @unique @map("event_id") @db.VarChar(150)
  eventType         String              @map("event_type") @db.VarChar(100)
  signatureVerified Boolean             @default(false) @map("signature_verified")
  status            ProviderEventStatus @default(RECEIVED)
  payload           Json                @db.JsonB
  errorMessage      String?             @map("error_message") @db.Text
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(6)
  receivedAt        DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([provider, eventType, status])
  @@map("saas_provider_events")
}

// 44. saas_invoices (Platform SaaS subscription invoices and receipts)
model SaaSInvoice {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  subscriptionId     String?           @map("subscription_id") @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  invoiceNumber      String            @unique @map("invoice_number") @db.VarChar(100)
  providerInvoiceId  String?           @map("provider_invoice_id") @db.VarChar(150)
  status             SaaSInvoiceStatus @default(OPEN)
  billingReason      String            @default("SUBSCRIPTION_CYCLE") @map("billing_reason") @db.VarChar(100)
  subtotalAmount     Decimal           @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount          Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency           String            @default("USD") @db.VarChar(3)
  periodStart        DateTime          @map("period_start") @db.Timestamptz(6)
  periodEnd          DateTime          @map("period_end") @db.Timestamptz(6)
  dueDate            DateTime          @map("due_date") @db.Timestamptz(6)
  paidAt             DateTime?         @map("paid_at") @db.Timestamptz(6)
  pdfUrl             String?           @map("pdf_url") @db.Text
  hostedInvoiceUrl   String?           @map("hosted_invoice_url") @db.Text
  lineItems          Json              @map("line_items") @db.JsonB
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription SaaSSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer     SaaSCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments     SaaSPayment[]

  @@index([organizationId, status])
  @@index([subscriptionId])
  @@map("saas_invoices")
}

// 45. saas_payments (Payment transactions settled or attempted against invoices)
model SaaSPayment {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  invoiceId          String?           @map("invoice_id") @db.Uuid
  subscriptionId     String?           @map("subscription_id") @db.Uuid
  providerPaymentId  String?           @map("provider_payment_id") @db.VarChar(150)
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("USD") @db.VarChar(3)
  status             SaaSPaymentStatus @default(PENDING)
  paymentMethodType  String            @default("CARD") @map("payment_method_type") @db.VarChar(50)
  failureReason      String?           @map("failure_reason") @db.VarChar(255)
  paidAt             DateTime?         @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      SaaSInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refunds      SaaSRefund[]

  @@index([organizationId, status])
  @@index([providerPaymentId])
  @@map("saas_payments")
}

// 46. saas_refunds (Partial or full refund tracking)
model SaaSRefund {
  id               String           @id @default(uuid()) @db.Uuid
  paymentId        String           @map("payment_id") @db.Uuid
  providerRefundId String?          @map("provider_refund_id") @db.VarChar(150)
  amount           Decimal          @db.Decimal(12, 2)
  currency         String           @default("USD") @db.VarChar(3)
  reason           String           @db.VarChar(255)
  status           SaaSRefundStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  payment SaaSPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("saas_refunds")
}

// 47. saas_credit_adjustments (Platform billing credit ledger)
model SaaSCreditAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  subscriptionId   String?  @map("subscription_id") @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD") @db.VarChar(3)
  reason           String   @db.VarChar(255)
  appliedInvoiceId String?  @map("applied_invoice_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription SaaSSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("saas_credit_adjustments")
}

// 48. saas_dunning_runs (Grace periods, retries, and dunning engine state)
model SaaSDunningRun {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  attemptCount   Int           @default(1) @map("attempt_count")
  maxAttempts    Int           @default(4) @map("max_attempts")
  status         DunningStatus @default(IN_PROGRESS)
  lastAttemptAt  DateTime      @default(now()) @map("last_attempt_at") @db.Timestamptz(6)
  nextAttemptAt  DateTime?     @map("next_attempt_at") @db.Timestamptz(6)
  gracePeriodEnd DateTime      @map("grace_period_end") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription SaaSSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@map("saas_dunning_runs")
}

// 49. platform_admin_roles (Privileged operator RBAC)
model PlatformAdminRole {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  role        PlatformAdminRoleType @default(OPERATOR)
  permissions String[]
  assignedAt  DateTime              @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy  String?               @map("assigned_by") @db.Uuid

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_admin_roles")
}

// 50. platform_incidents (System health incidents and operator audit)
model PlatformIncident {
  id                          String           @id @default(uuid()) @db.Uuid
  incidentNumber              String           @unique @map("incident_number") @db.VarChar(50)
  title                       String           @db.VarChar(255)
  description                 String           @db.Text
  severity                    IncidentSeverity @default(MEDIUM)
  status                      IncidentStatus   @default(OPEN)
  affectedServices            String[]         @map("affected_services")
  impactedOrganizationsCount  Int              @default(0) @map("impacted_organizations_count")
  declaredByUserId            String?          @map("declared_by_user_id") @db.Uuid
  resolvedAt                  DateTime?        @map("resolved_at") @db.Timestamptz(6)
  timeline                    Json             @default("[]")
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, severity])
  @@map("platform_incidents")
}

// 51. connector_providers (Third-party OAuth & API registry)
model ConnectorProvider {
  id                  String            @id @default(uuid()) @db.Uuid
  slug                String            @unique @db.VarChar(100)
  name                String            @db.VarChar(255)
  category            String            @db.VarChar(100)
  description         String?           @db.Text
  iconUrl             String?           @map("icon_url") @db.VarChar(500)
  authType            ConnectorAuthType @default(OAUTH2) @map("auth_type")
  clientId            String?           @map("client_id") @db.VarChar(255)
  clientSecretCipher  String?           @map("client_secret_cipher") @db.Text
  authUrl             String?           @map("auth_url") @db.VarChar(500)
  tokenUrl            String?           @map("token_url") @db.VarChar(500)
  scopesSupported     String[]          @map("scopes_supported")
  isEnabled           Boolean           @default(true) @map("is_enabled")
  isVerified          Boolean           @default(true) @map("is_verified")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  installations ConnectorInstallation[]
  oauthStates   OAuthState[]

  @@map("connector_providers")
}

// 52. connector_installations (Tenant connector installations & lifecycle)
model ConnectorInstallation {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @map("organization_id") @db.Uuid
  providerId            String                      @map("provider_id") @db.Uuid
  status                ConnectorInstallationStatus @default(PENDING)
  installedByUserId     String?                     @map("installed_by_user_id") @db.Uuid
  scopesGranted         String[]                    @map("scopes_granted")
  settings              Json                        @default("{}")
  externalAccountId     String?                     @map("external_account_id") @db.VarChar(255)
  externalAccountEmail   String?                     @map("external_account_email") @db.VarChar(255)
  lastSyncAt            DateTime?                   @map("last_sync_at") @db.Timestamptz(6)
  errorMessage          String?                     @map("error_message") @db.Text
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     ConnectorProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  credentials  ConnectorCredential?

  @@unique([organizationId, providerId])
  @@index([organizationId, status])
  @@map("connector_installations")
}

// 53. connector_credentials (AES-256-GCM encrypted vault for access & refresh tokens)
model ConnectorCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  installationId        String    @unique @map("installation_id") @db.Uuid
  encryptedAccessToken  String    @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  encryptionIv          String    @map("encryption_iv") @db.VarChar(64)
  encryptionTag         String    @map("encryption_tag") @db.VarChar(64)
  tokenType             String    @default("Bearer") @map("token_type") @db.VarChar(50)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)
  lastRefreshedAt       DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  installation ConnectorInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@map("connector_credentials")
}

// 54. oauth_states (Ephemeral CSRF/PKCE state tokens)
model OAuthState {
  id             String    @id @default(uuid()) @db.Uuid
  stateToken     String    @unique @map("state_token") @db.VarChar(128)
  organizationId String    @map("organization_id") @db.Uuid
  providerId     String    @map("provider_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  codeVerifier   String?   @map("code_verifier") @db.VarChar(255)
  redirectUri    String?   @map("redirect_uri") @db.VarChar(500)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     ConnectorProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([stateToken, expiresAt])
  @@map("oauth_states")
}

// 55. developer_api_keys (Organization programmatic API credentials with quota)
model DeveloperApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(150)
  keyPrefix       String    @map("key_prefix") @db.VarChar(32)
  keyHash         String    @unique @map("key_hash") @db.VarChar(128)
  scopes          String[]
  rateLimitPerMin Int       @default(60) @map("rate_limit_per_min")
  monthlyQuota    Int       @default(100000) @map("monthly_quota")
  usageCount      Int       @default(0) @map("usage_count")
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("developer_api_keys")
}

// 56. webhook_subscriptions (Outbound webhook subscriptions per tenant)
model WebhookSubscription {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  targetUrl         String                    @map("target_url") @db.VarChar(500)
  secretKey         String                    @map("secret_key") @db.VarChar(255)
  subscribedEvents  String[]                  @map("subscribed_events")
  status            WebhookSubscriptionStatus @default(ACTIVE)
  failureCount      Int                       @default(0) @map("failure_count")
  failureThreshold  Int                       @default(5) @map("failure_threshold")
  lastDeliveredAt   DateTime?                 @map("last_delivered_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, status])
  @@map("webhook_subscriptions")
}

// 57. webhook_deliveries (Outbound delivery logs, status, and retries)
model WebhookDelivery {
  id                  String                @id @default(uuid()) @db.Uuid
  subscriptionId      String                @map("subscription_id") @db.Uuid
  eventId             String                @map("event_id") @db.VarChar(100)
  eventType           String                @map("event_type") @db.VarChar(100)
  payload             Json
  responseStatusCode  Int?                  @map("response_status_code")
  responseBody        String?               @map("response_body") @db.Text
  executionDurationMs Int?                  @map("execution_duration_ms")
  attemptNumber       Int                   @default(1) @map("attempt_number")
  status              WebhookDeliveryStatus @default(PENDING)
  errorMessage        String?               @map("error_message") @db.Text
  nextRetryAt         DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@map("webhook_deliveries")
}

// 58. marketplace_listings (Dynamic App & Integration marketplace catalog)
model MarketplaceListing {
  id               String                   @id @default(uuid()) @db.Uuid
  slug             String                   @unique @db.VarChar(100)
  name             String                   @db.VarChar(255)
  category         String                   @db.VarChar(100)
  shortDescription String                   @map("short_description") @db.VarChar(500)
  longDescription  String?                  @map("long_description") @db.Text
  iconUrl          String?                  @map("icon_url") @db.VarChar(500)
  developerName    String                   @map("developer_name") @db.VarChar(255)
  version          String                   @default("1.0.0") @db.VarChar(50)
  pricingType      MarketplacePricingType   @default(FREE) @map("pricing_type")
  priceAmount      Decimal                  @default(0) @map("price_amount") @db.Decimal(12, 2)
  requiredScopes   String[]                 @map("required_scopes")
  capabilities     String[]
  installCount     Int                      @default(0) @map("install_count")
  reviewStatus     MarketplaceReviewStatus  @default(PUBLISHED) @map("review_status")
  isFeatured       Boolean                  @default(false) @map("is_featured")
  publishedAt      DateTime?                @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, reviewStatus])
  @@map("marketplace_listings")
}

// 59. feature_rollouts (Platform & tenant feature flags with targeting)
model FeatureRollout {
  id                    String        @id @default(uuid()) @db.Uuid
  flagKey               String        @unique @map("flag_key") @db.VarChar(100)
  name                  String        @db.VarChar(255)
  description           String?       @db.Text
  isEnabled             Boolean       @default(false) @map("is_enabled")
  rolloutPercentage     Int           @default(0) @map("rollout_percentage")
  targetEditions        PlanEdition[] @map("target_editions")
  targetOrganizationIds String[]      @map("target_organization_ids")
  targetUserIds         String[]      @map("target_user_ids")
  metadata              Json          @default("{}")
  updatedBy             String?       @map("updated_by") @db.VarChar(255)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_rollouts")
}

// ==========================================
// PHASE 2.1: WORKSPACE, DOCUMENTS & COLLAB
// ==========================================

enum PageAccessLevel {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

enum PageType {
  DOCUMENT
  CANVAS
  DATABASE_VIEW
  TEMPLATE
}

enum BlockType {
  HEADING_1
  HEADING_2
  HEADING_3
  PARAGRAPH
  BULLET_LIST
  NUMBERED_LIST
  CHECK_LIST
  QUOTE
  CODE
  TABLE
  CALLOUT
  TOGGLE
  DIVIDER
  IMAGE
  EMBED
}

enum CollabSnapshotType {
  AUTOSAVE
  CHECKPOINT
  MANUAL
  CRDT_STATE
}

// 60. ws_workspaces (Tenant-isolated Workspace roots)
model WsWorkspace {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  slug           String    @db.VarChar(100)
  description    String?   @db.Text
  icon           String?   @db.VarChar(100)
  isDefault      Boolean   @default(false) @map("is_default")
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages        WsPage[]
  favorites    WsPageFavorite[]

  @@unique([organizationId, slug])
  @@index([organizationId, isDefault])
  @@map("ws_workspaces")
}

// 61. ws_pages (Hierarchical workspace documents & templates)
model WsPage {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  parentId         String?   @map("parent_id") @db.Uuid
  title            String    @default("Untitled") @db.VarChar(255)
  icon             String?   @db.VarChar(100)
  coverUrl         String?   @map("cover_url") @db.VarChar(500)
  type             PageType  @default(DOCUMENT)
  isPublished      Boolean   @default(false) @map("is_published")
  publishedSlug    String?   @unique @map("published_slug") @db.VarChar(150)
  isTemplate       Boolean   @default(false) @map("is_template")
  templateCategory String?   @map("template_category") @db.VarChar(100)
  isArchived       Boolean   @default(false) @map("is_archived")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById      String?   @map("deleted_by_id") @db.Uuid
  orderIndex       Int       @default(0) @map("order_index")
  depth            Int       @default(0)
  createdById      String    @map("created_by_id") @db.Uuid
  updatedById      String?   @map("updated_by_id") @db.Uuid
  currentVersion   Int       @default(1) @map("current_version")
  contentJson      Json?     @map("content_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      WsWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent         WsPage?                @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       WsPage[]               @relation("PageHierarchy")
  createdBy      IdentityUser           @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  blocks         WsPageBlock[]
  revisions      WsPageRevision[]
  permissions    WsPagePermission[]
  comments       WsPageComment[]
  collabSnapshots WsPageCollabSnapshot[]
  collabEvents   WsPageCollabEvent[]
  favorites      WsPageFavorite[]

  @@index([organizationId, workspaceId, parentId, isDeleted])
  @@index([organizationId, isTemplate])
  @@index([organizationId, isDeleted])
  @@map("ws_pages")
}

// 62. ws_page_blocks (Modular content blocks in pages)
model WsPageBlock {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pageId         String    @map("page_id") @db.Uuid
  parentBlockId  String?   @map("parent_block_id") @db.Uuid
  blockType      BlockType @default(PARAGRAPH) @map("block_type")
  orderIndex     Int       @default(0) @map("order_index")
  content        Json      @default("{}")
  properties     Json      @default("{}")
  createdById    String    @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         WsPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentBlock  WsPageBlock?  @relation("BlockHierarchy", fields: [parentBlockId], references: [id], onDelete: Cascade)
  childBlocks  WsPageBlock[] @relation("BlockHierarchy")

  @@index([pageId, orderIndex])
  @@index([organizationId, pageId])
  @@map("ws_page_blocks")
}

// 63. ws_page_revisions (Immutable checkpoints and named versions)
model WsPageRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  version        Int
  title          String   @db.VarChar(255)
  contentJson    Json     @map("content_json")
  description    String?  @db.VarChar(255)
  isNamed        Boolean  @default(false) @map("is_named")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         WsPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy    IdentityUser @relation("RevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([pageId, version])
  @@index([organizationId, pageId, createdAt])
  @@map("ws_page_revisions")
}

// 64. ws_page_permissions (Fine-grained page ACLs by user, role, or team)
model WsPagePermission {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  pageId         String          @map("page_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  roleId         String?         @map("role_id") @db.Uuid
  teamId         String?         @map("team_id") @db.Uuid
  accessLevel    PageAccessLevel @default(VIEWER) @map("access_level")
  isInherited    Boolean         @default(false) @map("is_inherited")
  grantedById    String          @map("granted_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         WsPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user         IdentityUser? @relation("PagePermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  role         OrgRole?      @relation("PagePermissionRole", fields: [roleId], references: [id], onDelete: Cascade)
  team         OrgTeam?      @relation("PagePermissionTeam", fields: [teamId], references: [id], onDelete: Cascade)

  @@index([pageId, userId])
  @@index([pageId, roleId])
  @@index([pageId, teamId])
  @@index([organizationId, pageId])
  @@map("ws_page_permissions")
}

// 65. ws_page_comments (Inline comments, block threads, and mentions)
model WsPageComment {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  pageId          String    @map("page_id") @db.Uuid
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  blockId         String?   @map("block_id") @db.Uuid
  highlightText   String?   @map("highlight_text") @db.Text
  content         String    @db.Text
  authorId        String    @map("author_id") @db.Uuid
  isResolved      Boolean   @default(false) @map("is_resolved")
  resolvedById    String?   @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  mentions        String[]  @default([])
  attachments     Json      @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page          WsPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentComment WsPageComment?  @relation("CommentThreads", fields: [parentCommentId], references: [id], onDelete: Cascade)
  childComments WsPageComment[] @relation("CommentThreads")
  author        IdentityUser    @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([pageId, parentCommentId, isResolved])
  @@index([organizationId, pageId])
  @@map("ws_page_comments")
}

// 66. ws_page_collab_snapshots (Durable CRDT snapshots & autosaves)
model WsPageCollabSnapshot {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  pageId         String             @map("page_id") @db.Uuid
  snapshotType   CollabSnapshotType @default(AUTOSAVE) @map("snapshot_type")
  stateVector    Bytes?             @map("state_vector")
  crdtData       Bytes?             @map("crdt_data")
  version        Int                @default(1)
  clientCount    Int                @default(1) @map("client_count")
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         WsPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([organizationId, pageId])
  @@map("ws_page_collab_snapshots")
}

// 67. ws_page_collab_events (Presence, cursor moves, and active room telemetry)
model WsPageCollabEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(50)
  cursorPosition Json?    @map("cursor_position")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         WsPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user         IdentityUser @relation("CollabEventUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([pageId, createdAt])
  @@index([organizationId, pageId])
  @@map("ws_page_collab_events")
}

// 68. ws_page_favorites (User pinned & favorite pages)
model WsPageFavorite {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderIndex     Int      @default(0) @map("order_index")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    WsWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page         WsPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user         IdentityUser @relation("PageFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([organizationId, userId])
  @@map("ws_page_favorites")
}
